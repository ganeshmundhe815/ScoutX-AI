# ==============================================================================
# ScoutX-AI Universal Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
PORT_BACKEND=5000
NODE_ENV=development

# MongoDB Connection String:
# - Local MongoDB:  mongodb://127.0.0.1:27017/scoutx_db
# - Docker Compose: mongodb://mongodb:27017/scoutx_db
# - MongoDB Atlas:  mongodb+srv://<username>:<password>@cluster0.mongodb.net/scoutx_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/scoutx_db

# Security & JWT
JWT_SECRET=scoutx_jwt_super_secret_key_sih2025_khelo_india

# Allowed Frontend Origins (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:8081,http://127.0.0.1:8081

# Administrator Accounts
ADMIN_EMAILS=admin@scoutx.com,ganeshmundhe815@gmail.com
ADMIN_AUTH_CODE=SCOUTX-ADMIN-2025

# ------------------------------------------------------------------------------
# 2. Python AI & Computer Vision Microservice (MediaPipe & YOLOv8)
# ------------------------------------------------------------------------------
PORT_AI=8000
# Backend-to-AI Service URL:
# - Local dev:       http://localhost:8000
# - Docker Compose:  http://ai_service:8000
# - Render cloud:    https://scoutx-ai-service.onrender.com
AI_SERVICE_URL=http://localhost:8000
YOLO_MODEL_PATH=yolov8n.pt
PYTHONUNBUFFERED=1

# ------------------------------------------------------------------------------
# 3. Frontend Web & Mobile Application (React Native / Expo Web)
# ------------------------------------------------------------------------------
PORT_FRONTEND=8081
# Leave empty for automatic local LAN/localhost resolution, or set explicit endpoint:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
# Production cloud backend endpoint:
# EXPO_PUBLIC_API_URL=https://scoutx-backend.onrender.com/api
