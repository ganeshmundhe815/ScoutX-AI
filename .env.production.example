# ==============================================================================
# ScoutX-AI Production Environment Variable Checklist (.env.production)
# ==============================================================================
# Use this reference when setting environment variables on Render, Railway,
# Vercel, Netlify, or Docker Swarm/Kubernetes.

# ------------------------------------------------------------------------------
# BACKEND SERVICE (scoutx-backend)
# ------------------------------------------------------------------------------
# 1. Environment mode
NODE_ENV=production

# 2. Server Port (Render sets this dynamically via $PORT; default 5000)
PORT=5000

# 3. MongoDB Atlas Connection URI
# Create free M0 cluster at: https://www.mongodb.com/cloud/atlas
# Ensure Network Access whitelist has 0.0.0.0/0 (or your PaaS IP block)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxxx.mongodb.net/scoutx_db?retryWrites=true&w=majority

# 4. JWT Secret Key (Use a strong 64+ character random hex or alphanumeric key)
JWT_SECRET=production_secure_random_jwt_secret_change_me_in_real_deployment_99218

# 5. Python AI Vision Microservice URL
# Point to your deployed AI service (e.g. on Render, Railway, or Fly.io)
AI_SERVICE_URL=https://scoutx-ai-service.onrender.com

# 6. Allowed Client Web Origins (Comma-separated)
CLIENT_ORIGIN=https://scoutx-frontend.onrender.com,https://scoutx.vercel.app

# 7. Administrator Permissions
ADMIN_EMAILS=admin@scoutx.com,ganeshmundhe815@gmail.com
ADMIN_AUTH_CODE=SCOUTX-ADMIN-PROD-2025

# 8. Optional: Google OAuth 2.0 Credentials (if enabling Google login in production)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx

# ------------------------------------------------------------------------------
# PYTHON AI MICROSERVICE (scoutx-ai-service)
# ------------------------------------------------------------------------------
# Render dynamically passes $PORT. Microservice binds to 0.0.0.0:$PORT
PORT=8000
PYTHONUNBUFFERED=1
YOLO_MODEL_PATH=yolov8n.pt

# ------------------------------------------------------------------------------
# FRONTEND APPLICATION (scoutx-frontend / Vercel / Netlify)
# ------------------------------------------------------------------------------
# Base API URL pointing to the deployed backend API (always ends with /api)
EXPO_PUBLIC_API_URL=https://scoutx-backend.onrender.com/api
EXPO_NO_TELEMETRY=1
