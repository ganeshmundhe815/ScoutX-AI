# =====================================================================
# ScoutX-AI Backend Environment Configuration
# =====================================================================

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8081

# 1. MongoDB Database URI
# For local MongoDB: mongodb://127.0.0.1:27017/scoutx_db
# For Docker: mongodb://mongodb:27017/scoutx_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/scoutx_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/scoutx_db

# 2. JWT Authentication Secret
JWT_SECRET=scoutx_jwt_super_secret_key_sih2025_khelo_india

# 3. Python AI Vision Service URL
AI_SERVICE_URL=http://localhost:8000

# 4. Strict Administrator Access Security
# Comma-separated list of approved administrator emails
ADMIN_EMAILS=admin@scoutx.com,ganeshmundhe815@gmail.com
ADMIN_AUTH_CODE=SCOUTX-ADMIN-2025

# 5. Google OAuth 2.0 Configuration
# Create OAuth 2.0 Client IDs at: https://console.cloud.google.com/apis/credentials
# Add Authorized JavaScript Origins: http://localhost:8081, http://localhost:5000
# Add Authorized Redirect URIs: http://localhost:8081, https://auth.expo.io/@your-expo-username/frontend
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 6. Apple Sign-In Configuration
# Create Service ID and Keys at: https://developer.apple.com/account/resources/identifiers/list
APPLE_CLIENT_ID=com.scoutx.ai.service
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
